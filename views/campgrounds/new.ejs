<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Campground</title>
</head>
<body>
    <form action="/campgrounds" method="POST">
        <div>
            <label for="title">Title</label>
            <input type="text" id="title" name="campground[title]" required>
        </div>
        <div>
            <label for="location">Location</label>
            <input type="text" id="location" name="campground[location]" required>
        </div>
        <div>
            <label for="price">Price</label>
            <input type="number" id="price" name="campground[price]" required>
        </div>
        <div>
            <label for="description">Description</label>
            <textarea id="description" name="campground[description]" required></textarea>
        </div>
        <button type="submit">Add Campground</button>
    </form>

     <a href="/campgrounds">Back to All Campgrounds</a>
</body>
</html>